# ============================================================
#  Naseeb POS Backend — Environment Configuration
# ============================================================
#  Copy this file to `.env` and fill in your values.
#  (The backend reads POS_API_DATABASE_URL on startup.)
# ------------------------------------------------------------

# ---- ONLINE DATABASE (Supabase / PostgreSQL) ----
# Use Supabase as your online database:
#   1. Create a project at https://supabase.com
#   2. Project Settings → Database → Connection string → URI
#   3. Paste it below (change postgresql:// to postgresql+psycopg://)
#
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
#
# Example (Supabase):
#   POS_API_DATABASE_URL=postgresql+psycopg://postgres.abcd1234:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#
# Leave this commented/unset to use the default local SQLite file (pos_server.db).
# POS_API_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME

# ---- Seed data (optional) ----
# Path to the JSON file used to seed initial data on first run.
# SEED_DATA_PATH=/home/z/my-project/upload/seed_data.json

# ---- Seed on startup? ----
# Set to 0 to skip seeding (e.g. after the first run with real data).
# SEED_ON_STARTUP=1
