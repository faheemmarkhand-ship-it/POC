# ============================================================
#  Naseeb POS — Environment Variables (Vercel Deployment)
# ============================================================
#  Copy these into the Vercel project settings → Environment Variables.
#  (Dashboard → Settings → Environment Variables, or: vercel env add)
#
#  All variables below are SERVER-SIDE (no NEXT_PUBLIC_ prefix unless noted).
# ------------------------------------------------------------

# ---- Supabase (online PostgreSQL database) ----
# The project URL (visible to client, used for the frontend connectivity check too)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The publishable/anon key (safe for client-side; RLS policies allow read/write)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# The service role key (SERVER-ONLY — full DB access, bypasses RLS)
# Find it: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ---- Optional: direct PostgreSQL connection string ----
# Not used by the API routes (they use the Supabase REST API),
# but useful for running the schema push script locally.
# DATABASE_URL=postgresql://postgres:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
